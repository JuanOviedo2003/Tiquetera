# Configuración de variables de entorno para Tiquetera

# Puerto del servidor
PORT=3000
NODE_ENV=development

# Conexión MongoDB con Prisma ORM
# Para desarrollo local (si Mongo corre en localhost con replica set rs0):
DATABASE_URL="mongodb://localhost:27017/tiquetera?replicaSet=rs0&directConnection=true"

# Para Docker Compose (la red interna usa el nombre del servicio 'mongo'):
# DATABASE_URL="mongodb://mongo:27017/tiquetera?replicaSet=rs0&directConnection=true"
